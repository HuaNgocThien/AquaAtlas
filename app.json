{
  "expo": {
    "name": "AquaAtlas",
    "slug": "aqua-atlas",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aqua-atlas",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a3310"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a3310",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.huadev.aquaatlas",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b57b00da-e943-4a38-aa46-108d52e6102a"
      }
    }
  }
}